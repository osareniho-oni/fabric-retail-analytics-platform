      {
        "type": "Script",
        "typeProperties": {
          "scripts": [
            {
              "text": {
                "value": "DECLARE @MaxYear INT;\nDECLARE @CurrentYear INT = YEAR(GETDATE());\n\n-- Check the highest year currently in the dimension\nSELECT @MaxYear = MAX(Year)\nFROM dim.Date;\n\n-- Only rebuild if the dimension is missing the current year\nIF @MaxYear < @CurrentYear\nBEGIN\n    PRINT 'Updating Date Dimension...';\n\n    -- FK-safe delete\n    DELETE FROM dim.Date;\n\n    -- Reload from staging (dbo.Date)\n    INSERT INTO dim.Date (\n        DateKey,\n        FullDate,\n        Year,\n        Quarter,\n        Month,\n        MonthName,\n        Day,\n        DayOfWeek,\n        DayName,\n        QuarterName,\n        YearQuarter,\n        DayType\n    )\n    SELECT\n        DateKey,\n        FullDate,\n        Year,\n        Quarter,\n        Month,\n        MonthName,\n        Day,\n        DayOfWeek,\n        DayName,\n        QuarterName,\n        YearQuarter,\n        DayType\n    FROM dbo.Date;\n\n    PRINT 'Date Dimension updated successfully.';\nEND\nELSE\nBEGIN\n    PRINT 'Date Dimension already up to date. No action taken.';\nEND;\n",
                "type": "Expression"
              },
              "type": "Query"
            }
          ],
          "scriptBlockExecutionTimeout": "02:00:00"
        },
