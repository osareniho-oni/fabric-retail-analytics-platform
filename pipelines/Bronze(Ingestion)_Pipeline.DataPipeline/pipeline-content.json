              "typeProperties": {
                "scripts": [
                  {
                    "text": {
                      "value": "EXEC dbo.sp_WritePipelineAudit\n    @MasterRunId  = '@{pipeline().parameters.p_MasterRunId}',\n    @ChildRunId   = '@{pipeline().RunId}',\n    @Layer        = 'Bronze',\n    @SourceEntity = '@{item().properties.source.displayName}',\n    @TargetEntity = '@{item().properties.destination.displayName}',\n    @RowsRead     = @{coalesce(item().output.rowsRead, 'null')},\n    @RowsWritten  = @{coalesce(item().output.rowsCopied, 'null')},\n    @Status       = '@{item().status}';",
                      "type": "Expression"
                    },
                    "type": "Query"
                  }
                ],
                "scriptBlockExecutionTimeout": "02:00:00"
              },
              "linkedService": {
                "name": "dw_gold",
