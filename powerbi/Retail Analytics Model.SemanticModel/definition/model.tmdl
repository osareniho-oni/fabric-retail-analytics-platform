annotation PBI_QueryOrder = ["DirectLake - dw_gold","FinancialBridge"]

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb","WebModelingEdit","CalcGroup","RemoteModeling","DaxQueryView_Desktop"]

