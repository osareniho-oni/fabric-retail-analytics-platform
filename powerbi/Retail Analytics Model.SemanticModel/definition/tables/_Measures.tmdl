	measure 'Is Top Vendor Product' = ```
			
			// Helper measure to isolate Top N (e.g., Top 1 or Top 5) products in table visuals
			
			VAR _Rank = [Vendor Product Rank]
			RETURN 
			    IF(
			        NOT ISBLANK(_Rank) && _Rank <= 5, -- Change 5 to 1 if you only want the single most ordered product
			        1,
			        0
			    )
			```
		displayFolder: Requirement 04, 05 - Vendor Performance
		lineageTag: b377ffe8-1a71-541d-8e3b-71bbe98be36e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Vendor Delivery Days' = ```
			
			AVERAGEX(
			    'Purchase',
			    VAR _OrderDateKey = 'Purchase'[OrderDateKey]
			    VAR _DeliveryDateKey = 'Purchase'[DeliveryDateKey]
			    
			    -- Safe conversion for Order Date
			    VAR _OrderDate = 
			        IF(
			            NOT ISBLANK(_OrderDateKey) && _OrderDateKey > 0,
			            DATE(
			                QUOTIENT(_OrderDateKey, 10000), 
			                MOD(QUOTIENT(_OrderDateKey, 100), 100), 
			                MOD(_OrderDateKey, 100)
			            )
			        )
			        
			    -- Safe conversion for Delivery Date
			    VAR _DeliveryDate = 
			        IF(
			            NOT ISBLANK(_DeliveryDateKey) && _DeliveryDateKey > 0,
			            DATE(
			                QUOTIENT(_DeliveryDateKey, 10000), 
			                MOD(QUOTIENT(_DeliveryDateKey, 100), 100), 
			                MOD(_DeliveryDateKey, 100)
			            )
			        )
			    RETURN
			        IF(
			            NOT ISBLANK(_OrderDate) && NOT ISBLANK(_DeliveryDate),
			            DATEDIFF(_OrderDate, _DeliveryDate, DAY)
			        )
			)
			```
		displayFolder: Requirement 09 - Vendor Efficiency
		lineageTag: e65d5291-bce3-53fe-86dd-71ed2fc6fbcf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Fulfillment Lead Time (Days)' = ```
			
			// Days elapsed from order placement until vendor shipment (Fulfillment Lead Time)
			
			AVERAGEX(
			    'Purchase',
			    VAR _OrderDateKey = 'Purchase'[OrderDateKey]
			    VAR _ShipDateKey = 'Purchase'[ShipDateKey]
			    VAR _OrderDate = 
			        DATE(
			            QUOTIENT(_OrderDateKey, 10000), 
			            MOD(QUOTIENT(_OrderDateKey, 100), 100), 
			            MOD(_OrderDateKey, 100)
			        )
			    VAR _ShipDate = 
			        DATE(
			            QUOTIENT(_ShipDateKey, 10000), 
			            MOD(QUOTIENT(_ShipDateKey, 100), 100), 
			            MOD(_ShipDateKey, 100)
			        )
			    RETURN
			        DATEDIFF(_OrderDate, _ShipDate, DAY)
			)
			```
		displayFolder: Requirement 09 - Vendor Efficiency
		lineageTag: f5c63c36-9a50-5c81-bbaf-b4b4cb2239a9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Transit Time (Days)' = ```
			
			// Transit time from vendor dispatch to store receipt
			
			AVERAGEX(
			    'Purchase',
			    VAR _ShipDateKey = 'Purchase'[ShipDateKey]
			    VAR _DeliveryDateKey = 'Purchase'[DeliveryDateKey]
			    VAR _ShipDate = 
			        DATE(
			            QUOTIENT(_ShipDateKey, 10000), 
			            MOD(QUOTIENT(_ShipDateKey, 100), 100), 
			            MOD(_ShipDateKey, 100)
			        )
			    VAR _DeliveryDate = 
			        DATE(
			            QUOTIENT(_DeliveryDateKey, 10000), 
			            MOD(QUOTIENT(_DeliveryDateKey, 100), 100), 
			            MOD(_DeliveryDateKey, 100)
			        )
			    RETURN
			        DATEDIFF(_ShipDate, _DeliveryDate, DAY)
			)
			```
		displayFolder: Requirement 09 - Vendor Efficiency
		lineageTag: d903e1eb-67a3-5848-901a-657170e61048

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Late Deliveries Count' = ```
			
			// Count of orders that took longer than the agreed target threshold (e.g., > 14 days)
			
			VAR _SLAThresholdDays = 14
			RETURN
			    CALCULATE(
			        COUNTROWS('Purchase'),
			        FILTER(
			            'Purchase',
			            VAR _OrderKey = 'Purchase'[OrderDateKey]
			            VAR _DeliveryKey = 'Purchase'[DeliveryDateKey]
			            VAR _OrderDate = 
			                DATE(
			                    QUOTIENT(_OrderKey, 10000), 
			                    MOD(QUOTIENT(_OrderKey, 100), 100), 
			                    MOD(_OrderKey, 100)
			                )
			            VAR _DeliveryDate = 
			                DATE(
			                    QUOTIENT(_DeliveryKey, 10000), 
			                    MOD(QUOTIENT(_DeliveryKey, 100), 100), 
			                    MOD(_DeliveryKey, 100)
			                )
			            RETURN
			                DATEDIFF(_OrderDate, _DeliveryDate, DAY) > _SLAThresholdDays
			        )
			    )
			```
		displayFolder: Requirement 09 - Vendor Efficiency
		lineageTag: 6360c9cb-b23f-5c2e-abdb-e38c204f9947

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Late Delivery Rate %' =
			
			DIVIDE([Late Deliveries Count], [Total Purchase Orders], 0)
		displayFolder: Requirement 09 - Vendor Efficiency
		lineageTag: 5cd77173-b209-509c-9adc-89793d5565f1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

