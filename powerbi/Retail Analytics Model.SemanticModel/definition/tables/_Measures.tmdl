	measure 'Vendor Product Rank' =
			
			// Dynamic rank of products per Vendor & Store combination
			
			IF(
			    ISINSCOPE('Product'[Product Name]),
			    RANKX(
			        ALLSELECTED('Product'[Product Name]),
			        [Total Purchase Quantity],
			        ,
			        DESC,
			        Dense
			    )
			)
		displayFolder: Requirement 04, 05 - Vendor Performance
		lineageTag: 94496253-846e-5dcd-8b9f-716424f10c7a

