	measure 'Store vs Network Avg %' =
			
			VAR _NetworkAvg = [Network Avg Store Sales]
			RETURN
			    DIVIDE([Store Net Sales] - _NetworkAvg, _NetworkAvg, 0)
		displayFolder: Store Performance Analysis
		lineageTag: 85e5b648-7b32-59f5-b98b-b07f572e728d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Store Performance Status' =
			
			VAR _StoreSales = [Store Net Sales]
			VAR _NetworkAvg = [Network Avg Store Sales]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(_StoreSales), BLANK(),
			        _StoreSales >= _NetworkAvg * 1.15, "Top Performer",
			        _StoreSales <= _NetworkAvg * 0.85, "Underperformer",
			        "Average Performer"
			    )
		displayFolder: Store Performance Analysis
		lineageTag: cc2fc891-10c9-597f-8af2-0ec642916a7b

