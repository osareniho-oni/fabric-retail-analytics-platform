	measure 'Total Orders' = DISTINCTCOUNT(Sales[TransactionNumber])
		displayFolder: Requirement 02 - Market Basket Analysis
		lineageTag: 7df0f6e5-6140-5224-a6e3-868640fb871c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Basket Selected Orders' =
			
			// Calculates how many transactions contained the product selected in the basket slicer.
			
			VAR _SelectedBasketProducts = VALUES('Product_Basket'[ProductKey])
			RETURN
			CALCULATE(
			    [Total Orders],
			    REMOVEFILTERS('Product'),
			    'Sales'[ProductKey] IN _SelectedBasketProducts
			)
		displayFolder: Requirement 02 - Market Basket Analysis
		lineageTag: dbf1c8be-e804-5995-921a-71f548baac7c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Co-Purchased Orders' = ```
			
			// Evaluates how often products from the primary Product table appear in the same transaction (TransactionNumber) as the selected basket product.
			
			VAR _SelectedBasketProducts = VALUES('Product_Basket'[ProductKey])
			VAR _TargetTransactions = 
			    CALCULATETABLE(
			        VALUES('Sales'[TransactionNumber]),
			        REMOVEFILTERS('Product'),
			        'Sales'[ProductKey] IN _SelectedBasketProducts
			    )
			RETURN
			    CALCULATE(
			        [Total Orders],
			        'Sales'[TransactionNumber] IN _TargetTransactions
			    )
			```
		displayFolder: Requirement 02 - Market Basket Analysis
		lineageTag: bc56b789-6ff2-5186-b35f-5cba9ad1f968

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Attachment Rate %' =
			
			// The percentage of orders containing Product A that also contained Product B.
			
			DIVIDE([Co-Purchased Orders], [Basket Selected Orders], 0)
		displayFolder: Requirement 02 - Market Basket Analysis
		lineageTag: e6b55804-c277-5704-964b-b70688587654

		annotation PBI_FormatHint = {"isGeneralNumber":true}

