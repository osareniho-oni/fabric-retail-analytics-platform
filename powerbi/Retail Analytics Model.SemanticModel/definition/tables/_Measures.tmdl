	measure 'Distinct Sales Transactions' = DISTINCTCOUNT('Sales'[TransactionNumber])
		displayFolder: Sales & POS Performances
		lineageTag: 6a048c25-762e-5da4-b494-d7dda7204962

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Basket Co-Purchase Count' = ```
			
			VAR _SelectedRowProductName = SELECTEDVALUE( 'Product'[Product Name] )
			VAR _SelectedColProductName = SELECTEDVALUE( 'product_basket'[ProductName] )
			RETURN
			    IF (
			        ISBLANK( _SelectedRowProductName ) || ISBLANK( _SelectedColProductName ),
			        BLANK(),
			        IF (
			            -- Hide the diagonal row where a product matches itself
			            _SelectedRowProductName = _SelectedColProductName, 
			            BLANK(),
			            
			            -- Intersect using the literal Product Names via a shared data relationship
			            VAR _RowTransactions = 
			                CALCULATETABLE(
			                    VALUES( 'Sales'[TransactionNumber] ),
			                    'Product'[Product Name] = _SelectedRowProductName,
			                    REMOVEFILTERS( 'Product' )
			                )
			            VAR _ColTransactions = 
			                CALCULATETABLE(
			                    VALUES( 'Sales'[TransactionNumber] ),
			                    -- Map the cloned name back to the core Product table name field
			                    TREATAS( { _SelectedColProductName }, 'Product'[Product Name] ),
			                    REMOVEFILTERS( 'Product' )
			                )
			            RETURN
			                COUNTROWS( INTERSECT( _RowTransactions, _ColTransactions ) )
			        )
			    )
			
			```
		displayFolder: Sales & POS Performances
		lineageTag: b6cfd18f-229b-509d-b991-84a4011944a8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Co-Purchase Transaction Count' = ```
			
			VAR _SelectedProduct =
			    SELECTEDVALUE('Product'[Product Name])
			
			VAR _CoPurchaseProduct =
			    SELECTEDVALUE('Product_Basket'[ProductName])
			
			RETURN
			IF (
			    NOT ISBLANK(_SelectedProduct)
			        && NOT ISBLANK(_CoPurchaseProduct)
			        && _SelectedProduct <> _CoPurchaseProduct,
			        
			    VAR _TransactionsWithProductA =
			        CALCULATETABLE (
			            VALUES ( 'Sales'[TransactionNumber] ),
			            'Product'[Product Name] = _SelectedProduct
			        )
			
			    VAR _TransactionsWithProductB =
			        CALCULATETABLE (
			            VALUES ( 'Sales'[TransactionNumber] ),
			            TREATAS(
			                { _CoPurchaseProduct },
			                'Product'[Product Name]
			            )
			        )
			
			    VAR _Overlap =
			        INTERSECT ( _TransactionsWithProductA, _TransactionsWithProductB )
			
			    RETURN
			        COUNTROWS ( _Overlap )
			)
			
			```
		displayFolder: Sales & POS Performances
		lineageTag: 651deb79-8845-587f-9b97-c000ac376d01

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CoPurchase Count' = ```
			
			VAR ProductA =
			    SELECTEDVALUE ( 'Product'[Product Name] )
			
			RETURN
			CALCULATE (
			    DISTINCTCOUNT ( 'Sales'[TransactionNumber] ),
			    KEEPFILTERS ( 'Product'[Product Name] = ProductA )
			)
			
			```
		lineageTag: fa81e6c5-2486-5cbc-8a42-4bef241114fa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Basket Transactions' =
			
			VAR TransactionsA =
			    CALCULATETABLE(
			        VALUES(Sales[TransactionNumber]),
			        ALL(Product_Basket)
			    )
			
			VAR TransactionsB =
			    CALCULATETABLE(
			        VALUES(Sales[TransactionNumber]),
			        ALL(Product[Product Name]),
			        TREATAS(
			            VALUES(Product_Basket[ProductName]),
			            Product[Product Name]
			        )
			    )
			
			RETURN
			    COUNTROWS(
			        INTERSECT(
			            TransactionsA,
			            TransactionsB
			        )
			    )
		lineageTag: 958ea2ee-e717-574a-8006-73826557e63c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Test Transactions' =
			
			DISTINCTCOUNT(Sales[TransactionNumber])
