		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'POS Avg Days Between Replacements' = ```
			
			VAR Dates =
			    CALCULATETABLE(
			        VALUES('Date'[Full Date]),
			        POSDeviceChange[ChangeType] = "Replacement"
			    )
			VAR SortedDates =
			    ADDCOLUMNS(
			        Dates,
			        "NextDate",
			            CALCULATE(
			                MIN('Date'[Full Date]),
			                FILTER(
			                    Dates,
			                    'Date'[Full Date] > EARLIER('Date'[Full Date])
			                )
			            )
			    )
			VAR Differences =
			    SELECTCOLUMNS(
			        FILTER(SortedDates, NOT ISBLANK([NextDate])),
			        "Diff",
			            DATEDIFF('Date'[Full Date], [NextDate], DAY)
			    )
			RETURN
			IF(
			    COUNTROWS(Differences) = 0,
			    BLANK(),
			    AVERAGEX(Differences, [Diff])
			)
			
			```
		displayFolder: Requirement 03 - POS Channel Analysis
		lineageTag: 363e885a-a372-5b27-824b-610f411f814f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'POS Most Replaced Model' = ```
			
			CALCULATE(
			    FIRSTNONBLANK(POSDeviceChange[OldSerialNumber], 1),
			    POSDeviceChange[ChangeType] = "Replacement"
			)
			
			```
		displayFolder: Requirement 03 - POS Channel Analysis
