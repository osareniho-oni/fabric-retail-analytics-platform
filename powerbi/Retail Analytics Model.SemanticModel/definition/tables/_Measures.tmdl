	measure 'Store Sales Rank' =
			
			IF(
			    ISINSCOPE('Store'[Store Name]) || ISINSCOPE('Store'[StoreID]),
			    RANKX(
			        ALLSELECTED('Store'[Store Name]),
			        [Store Net Sales],
