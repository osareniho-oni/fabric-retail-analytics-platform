	measure 'Intraday Quantity Sold' = [Total Quantity Sold]
		displayFolder: Sales & POS Performances
		lineageTag: a39b7ad7-906b-5617-bb32-31403e6e0e3c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Co-Purchase Basket Count' = ```
			
			VAR _ActiveProduct = SELECTEDVALUE('Product'[ProductKey])
			
			-- Step 1: Find all transactions that contain the selected product
			VAR _TransactionsWithActiveProduct = 
			    CALCULATETABLE(
			        VALUES('Sales'[TransactionNumber]),
			        REMOVEFILTERS('Product'),
			        'Sales'[ProductKey] = _ActiveProduct
			    )
			
			RETURN
			    IF(
			        ISFILTERED('Product'[ProductKey]),
			        CALCULATE(
			            DISTINCTCOUNT('Sales'[TransactionNumber]),
			            -- Step 2: Remove active product filter and apply the list of transactions
			            REMOVEFILTERS('Product'),
			            'Sales'[TransactionNumber] IN _TransactionsWithActiveProduct,
			            -- Step 3: Exclude the selected product itself so you only count multi-item baskets
			            'Sales'[ProductKey] <> _ActiveProduct
			        )
			    )
			```
		displayFolder: Sales & POS Performances
		lineageTag: f5bf4f5b-6eff-54ed-b5c9-e1506bf72ac2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Device Lifespan (Days)' = ```
			
			VAR _TotalLifespan = 
			    SUMX(
			        'POSChannel',
			        DATEDIFF('POSChannel'[ValidFrom], 'POSChannel'[ValidTo], DAY)
			    )
			RETURN 
			    DIVIDE(_TotalLifespan, DISTINCTCOUNT('POSChannel'[ChannelKey]), BLANK())
			
			```
		formatString: 0
		displayFolder: Sales & POS Performances
		lineageTag: ec1c6ace-3739-5aa7-a183-fa8356d0397c

	measure 'POS Device Replacements' = COUNT('POSDeviceChange'[POSDeviceChangeKey])
		formatString: 0
