		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Purchased Quantity' = SUM(Purchase[Quantity])
		displayFolder: Profitability\Purchase Metrics
		lineageTag: 5edd0b68-0e80-57ba-8e59-0120388c3986

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Production Cost' =
			
			SUM( 'Purchase'[Line Amount] ) + SUM( 'Purchase'[Tax Amount] )
		displayFolder: Profitability\Purchase Metrics
		lineageTag: d33f33c3-12c2-57c0-9a9d-93f575095d99

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Unit Cost' = ```
			
			DIVIDE(
			    [Production Cost],
			    [Purchased Quantity],
			    0
			)
			
			```
		displayFolder: Profitability\Purchase Metrics
		lineageTag: 7d552a61-5e3c-52a8-974c-8bbbaba2272d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure COGS = ```
			
			VAR _SelectedYear = SELECTEDVALUE( 'Date'[Year] )
			RETURN
			    IF (
			        ISBLANK( _SelectedYear ),
			        BLANK(),
			        SUMX(
			            'Sales',
			            VAR _SalesQty = 'Sales'[Quantity]
			            VAR _ContextCost = 
			                CALCULATE(
			                    [Average Unit Cost],
			                    REMOVEFILTERS( 'Date' ), -- Clear the matrix layout constraint
			                    -- Filter the 8-digit Purchase key to fall within the selected year
			                    'Purchase'[OrderDateKey] >= ( _SelectedYear * 10000 + 0101 ) &&
			                    'Purchase'[OrderDateKey] <= ( _SelectedYear * 10000 + 1231 )
			                )
			            RETURN
			                _SalesQty * _ContextCost
			        )
			    )
			
			```
		displayFolder: Profitability
		lineageTag: 8d550298-1e52-58f9-af37-4f46a52132a5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Profit' =
			
			[Net Revenue] - [COGS]
		displayFolder: Profitability
		lineageTag: 51ff93da-71a0-52ab-aaef-668546a1b573

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dynamic Top N Net Revenue' = ```
			
			VAR _SelectedN = [Top N Selection Value] -- Reads the value from your slider
			VAR _ProductRank = 
			    IF(
			        ISINSCOPE('Product'[Product Name]),
			        RANKX(
			            ALLSELECTED('Product'[Product Name]),
			            [Net Revenue], -- Ranks products by Net Revenue
			            ,
			            DESC,
			            Dense
			        ),
			        BLANK()
			    )
			RETURN
			    IF(
			        NOT ISBLANK([Net Revenue]) && _ProductRank <= _SelectedN,
			        [Net Revenue],
			        BLANK()
			    )
			
			```
		displayFolder: Profitability
		lineageTag: db059638-4fed-566c-af1d-2a3b3a06ab6b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Growth Status Indicator' = ```
			
			VAR _RevGrowth = 
			    DIVIDE(
			        [Net Revenue] - CALCULATE([Net Revenue], SAMEPERIODLASTYEAR('Date'[Full Date])),
			        CALCULATE([Net Revenue], SAMEPERIODLASTYEAR('Date'[Full Date])),
			        0
			    )
			VAR _CostGrowth = 
			    DIVIDE(
			        [Production Cost] - CALCULATE([Production Cost], SAMEPERIODLASTYEAR('Date'[Full Date])),
			        CALCULATE([Production Cost], SAMEPERIODLASTYEAR('Date'[Full Date])),
			        0
			    )
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(_RevGrowth) && ISBLANK(_CostGrowth), BLANK(),
			        _CostGrowth > _RevGrowth, 1,    // Danger Zone: Costs rising faster than sales
			        _RevGrowth >= _CostGrowth, 2,   // Healthy Zone: Sales outpacing costs
			        3                              // Neutral Fallback
			    )
			
			```
		displayFolder: Profitability
		lineageTag: 8eb70e37-a1c8-5c6c-847d-91b02d1e5f15

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Margin Card Color' = ```
			
			VAR _TargetMargin = 0.15 -- target margin (15%)
			VAR _CurrentMargin = [Gross Profit Margin %]
			RETURN
			    IF(
			        ISBLANK(_CurrentMargin),
			        "#FFFFFF", -- Default White if no data
			        IF(
			            _CurrentMargin < _TargetMargin,
			            "#FADBD8", -- Soft Coral Red for underperformance
			            "#D4EFDF"  -- Soft Mint Green for healthy margins
			        )
			    )
			
			```
		displayFolder: Profitability
		lineageTag: 4a32819e-690c-53ea-a515-80ab3ad31a66

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue Card Color' = ```
			
			VAR _RevenueGrowth = 
			    CALCULATE(
			        [Net Revenue], -- base measure
			        'Time Intelligence'[Period] = "YoY Growth %" -- calculation item name
			    )
			RETURN
			    IF(
			        ISBLANK(_RevenueGrowth),
			        "#FFFFFF", -- Default White
			        IF(
			            _RevenueGrowth < 0,
			            "#FADBD8", -- Soft Coral Red for declining revenue
			            "#D4EFDF"  -- Soft Mint Green for positive growth
			        )
			    )
			
			```
		displayFolder: Profitability
		lineageTag: 143cce8a-108b-55ef-991c-9553ba678799

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dynamic Bridge Value' =
			
			SWITCH(
			    SELECTEDVALUE('FinancialBridge'[StepID]),
			    1, [Net Revenue],
			    // 2, -[COGS],          -- Cleans up the bridge by dropping the cost bar DOWN
			    3, [Gross Profit],
			    BLANK()
			)
		displayFolder: Profitability
		lineageTag: 5ba0c104-b30a-536a-9fa3-9f6de13d5a6b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dynamic Bottom N Net Revenue' = ```
			
			VAR _SelectedN = [Top N Selection Value] -- Reads the value from your existing slider
			VAR _ProductRank = 
			    IF(
			        ISINSCOPE('Product'[Product Name]),
			        RANKX(
			            ALLSELECTED('Product'[Product Name]),
			            [Net Revenue],
			            ,
			            ASC, -- Enforces ascending order to rank lowest revenue products as #1
			            Dense
			        ),
			        BLANK()
			    )
			RETURN
			    IF(
			        NOT ISBLANK([Net Revenue]) && _ProductRank <= _SelectedN,
			        [Net Revenue],
			        BLANK()
			    )
			
			```
		displayFolder: Profitability
		lineageTag: 8155c49c-ba52-5c1f-b57b-23430ab1bfc3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Financial Bridge Color' = ```
			
			SWITCH(
			    SELECTEDVALUE('FinancialBridge'[StepID]),
			    1, "#10B981", -- 1. Net Revenue: Soft Emerald Green
			    2, "#EF4444", -- 2. Less: COGS: Soft Coral Red
			    3, "#0A2540", -- 3. Gross Profit: Corporate Deep Navy
			    "#0A2540"     -- Fallback color
			)
			
			```
		displayFolder: Profitability
		lineageTag: 83be54e4-e667-5340-9c24-7a81845549c3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Bridge Expense Line' = ```
			
			IF(
			    SELECTEDVALUE('FinancialBridge'[StepID]) = 2,
			    [COGS],
			    BLANK()
			)
			
			```
		displayFolder: Profitability
		lineageTag: a02dcb49-c7f4-58a8-ad64-e73346b7f4cf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Marginal Revenue' = ```
			
			VAR _CurrentRevenue = [Net Revenue]
			VAR _CurrentQty = [Total Quantity Sold]
			
			-- Grabs net sales revenue from the immediate prior period block
			VAR _PriorRevenue = 
			    CALCULATE(
			        [Net Revenue],
			        OFFSET(
			            -1, 
			            ALLSELECTED('Date'[Year], 'Date'[Quarter], 'Date'[Month Name]), 
			            ORDERBY('Date'[Year], ASC, 'Date'[Month Name], ASC)
			        )
			    )
			
			-- Grabs total units sold from the immediate prior period block
			VAR _PriorQty = 
			    CALCULATE(
			        [Total Quantity Sold],
			        OFFSET(
			            -1, 
			            ALLSELECTED('Date'[Year], 'Date'[Quarter], 'Date'[Month Name]), 
			            ORDERBY('Date'[Year], ASC, 'Date'[Month Name], ASC)
			        )
			    )
			
			VAR _DeltaRevenue = _CurrentRevenue - _PriorRevenue
			VAR _DeltaQuantity = _CurrentQty - _PriorQty
			
			RETURN
			    DIVIDE(_DeltaRevenue, _DeltaQuantity, BLANK())
			
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Profitability\Sales Metrics
		lineageTag: e1f216ce-dcea-5fe7-a6d7-df8f4b35527f

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Marginal Production Cost' = ```
			
			VAR _CurrentCost = [Production Cost]
			VAR _CurrentQty = [Purchased Quantity]
			
			-- Automatically finds the prior period based on whatever date fields are in your visual rows
			VAR _PriorCost = 
			    CALCULATE(
			        [Production Cost],
			        OFFSET(
			            -1, 
			            ALLSELECTED('Date'[Year], 'Date'[Quarter], 'Date'[Month Name]), 
			            ORDERBY('Date'[Year], ASC, 'Date'[Month Name], ASC)
			        )
			    )
			
			VAR _PriorQty = 
			    CALCULATE(
			        [Purchased Quantity],
			        OFFSET(
			            -1, 
			            ALLSELECTED('Date'[Year], 'Date'[Quarter], 'Date'[Month Name]), 
			            ORDERBY('Date'[Year], ASC, 'Date'[Month Name], ASC)
			        )
			    )
			
			VAR _DeltaCost = _CurrentCost - _PriorCost
			VAR _DeltaQty = _CurrentQty - _PriorQty
			
			RETURN
			    DIVIDE(_DeltaCost, _DeltaQty, BLANK())
			
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Profitability\Purchase Metrics
		lineageTag: 075a2f6b-7f28-598c-984b-c5e99f95c0f0

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Marginal Profit Spread' = [Marginal Revenue] - [Marginal Production Cost]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Profitability
		lineageTag: bbc8f687-019c-53bd-ab73-d91e9653eac9

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Marginal Efficiency Ratio' =
			
			DIVIDE([Marginal Revenue], [Marginal Production Cost], 0)
		displayFolder: Profitability
		lineageTag: 791d4e1c-f7e2-5814-9c07-01d32bcc9ba0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Marginal Status Indicator' = ```
			
			VAR _MarginalRev = [Marginal Revenue]
			VAR _MarginalCost = [Marginal Production Cost]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(_MarginalRev) && ISBLANK(_MarginalCost), BLANK(),
			        _MarginalCost > _MarginalRev, 1,    -- Danger Zone: Cost to produce 1 extra unit is higher than its revenue
			        _MarginalRev >= _MarginalCost, 2,   -- Healthy Zone: Extra unit revenue covers its cost
			        3                                  -- Fallback
			    )
			
			```
