	measure 'Avg Days Between Replacement' =
			
			VAR _TotalReplacements = [POS Device Replacements]
			VAR _TotalOperatingDays = DISTINCTCOUNT('Sales'[TransactionDateKey]) -- Active operational window
			RETURN
			    DIVIDE(_TotalOperatingDays, _TotalReplacements, BLANK())
