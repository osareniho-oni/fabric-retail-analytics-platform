	measure 'Network Avg Store Sales' = ```
			
			-- Average Net Sales per store location across the active filter context
			 
			CALCULATE(
			    AVERAGEX(
			        VALUES('Store'[StoreID]),
			        [Store Net Sales]
			    ),
			    ALLSELECTED('Store')
			)
