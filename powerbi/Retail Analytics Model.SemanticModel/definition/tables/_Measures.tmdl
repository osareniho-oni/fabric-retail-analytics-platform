	measure 'Promo Sales Lift %' = ```
			
			VAR _PromoSales = CALCULATE([Net Revenue], 'Promotion'[Discount Percent] > 0)
			VAR _BaseSales = CALCULATE([Net Revenue], 'Promotion'[Discount Percent] = 0)
			RETURN 
			    DIVIDE(_PromoSales, _BaseSales, 0)
			
			```
		formatString: 0.00%;-0.00%;0.00%
